# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://sla:sla@localhost:5433/sla_tracker?schema=public"

# Auth
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Only someone who knows this code may register with role=AGENT.
AGENT_SIGNUP_CODE="let-me-in"

# Business hours configuration (IANA timezone)
BUSINESS_TIMEZONE="Asia/Kolkata"
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18

# Server
PORT=4000
