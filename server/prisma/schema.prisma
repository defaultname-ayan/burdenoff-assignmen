generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REPORTER
  AGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  reportedTickets Ticket[]  @relation("ticketReporter")
  assignedTickets Ticket[]  @relation("ticketAssignee")
  comments        Comment[]

  @@index([role])
}

model Ticket {
  id          String       @id @default(uuid())
  number      Int          @unique @default(autoincrement())
  title       String
  description String
  priority    Priority
  status      TicketStatus @default(OPEN)

  reporterId String
  reporter   User   @relation("ticketReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("ticketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// First comment by someone other than the reporter. Never overwritten.
  firstResponseAt DateTime?
  /// Set on entering RESOLVED.
  resolvedAt      DateTime?

  /// SLA targets in business hours. Persisting them keeps SLA state a
  /// timestamp comparison, usable from resolvers and SQL filters alike.
  firstResponseDueAt    DateTime
  firstResponseAtRiskAt DateTime
  resolutionDueAt       DateTime
  resolutionAtRiskAt    DateTime
  /// Creation, or the last reopen.
  slaStartedAt          DateTime

  comments Comment[]
  events   TicketEvent[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([createdAt, id])
  @@index([resolvedAt, resolutionDueAt])
  @@index([firstResponseAt, firstResponseDueAt])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

/// Audit trail for status and assignee changes.
model TicketEvent {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  type      String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Holiday {
  id   String   @id @default(uuid())
  /// Stored as midnight UTC so the calendar key is timezone-free.
  date DateTime @unique @db.Date
  name String

  @@index([date])
}
